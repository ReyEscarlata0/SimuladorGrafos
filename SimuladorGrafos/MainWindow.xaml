<Window x:Class="SimuladorGrafos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimuladorGrafos.ViewModels"
        xmlns:conv="clr-namespace:SimuladorGrafos.Converters"
        Title="Simulador Visual de Algoritmos de Grafos" Height="800" Width="1360"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:EstadoNodoABrushConverter x:Key="EstadoNodoABrush"/>
        <conv:EstadoAristaABrushConverter x:Key="EstadoAristaABrush"/>
        <conv:EstadoAristaAGrosorConverter x:Key="EstadoAristaAGrosor"/>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVisibilidad"/>
        <conv:NuloAVisibilidadConverter x:Key="NuloAVisibilidad"/>
        <conv:EsNuloAVisibilidadConverter x:Key="EsNuloAVisibilidad"/>
        <conv:CadenaAVisibilidadConverter x:Key="CadenaAVisibilidad"/>

        <DrawingBrush x:Key="CanvasDotGridBrush" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource CanvasDotBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1.4,1.4" RadiusX="1.4" RadiusY="1.4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="TarjetaBarraStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="TituloBarraStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BotonBarraStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="360"/>
        </Grid.RowDefinitions>

        <!-- ===================== Encabezado ===================== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="22,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                        <TextBlock Text="🕸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Simulador Visual de Algoritmos de Grafos" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="BFS · DFS · Dijkstra · Bellman-Ford · Prim · Kruskal" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Algoritmo activo:" Style="{StaticResource SubtleTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AlgoritmoSeleccionado.Nombre}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Barra de opciones (distribuida arriba) ===================== -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="16,8,4,6">

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="160">
                    <StackPanel>
                        <TextBlock Text="🧩 Edición" Style="{StaticResource TituloBarraStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="➕ Nodo" Command="{Binding ActivarModoNodoCommand}" Style="{StaticResource BotonBarraStyle}"/>
                            <Button Content="🔗 Arista" Command="{Binding ActivarModoAristaCommand}" Style="{StaticResource BotonBarraStyle}"/>
                        </UniformGrid>
                        <TextBlock Margin="1,5,1,0" TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" FontSize="10.5">
                            <Run Text="Modo: "/><Run Text="{Binding ModoEdicion}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="150">
                    <StackPanel>
                        <TextBlock Text="📂 Ejemplo" Style="{StaticResource TituloBarraStyle}"/>
                        <UniformGrid Columns="3">
                            <Button Content="Ej. 1" Command="{Binding CargarEjemploCommand}" CommandParameter="0" Style="{StaticResource BotonBarraStyle}"/>
                            <Button Content="Ej. 2" Command="{Binding CargarEjemploCommand}" CommandParameter="1" Style="{StaticResource BotonBarraStyle}"/>
                            <Button Content="🗑" ToolTip="Grafo nuevo (en blanco)" Command="{Binding NuevoGrafoCommand}" Style="{StaticResource BotonBarraStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="205">
                    <StackPanel>
                        <TextBlock Text="⚙ Algoritmo" Style="{StaticResource TituloBarraStyle}"/>
                        <ComboBox ItemsSource="{Binding Algoritmos}" DisplayMemberPath="Nombre"
                                  SelectedItem="{Binding AlgoritmoSeleccionado}" Padding="6,4" FontSize="11"/>

                        <TextBlock Text="Nodo de inicio" Style="{StaticResource SubtleTextStyle}" FontSize="10" Margin="0,5,0,3"/>
                        <ComboBox ItemsSource="{Binding Nodos}" DisplayMemberPath="Etiqueta"
                                  SelectedItem="{Binding NodoInicioSeleccionado}" Padding="6,4" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="205">
                    <StackPanel>
                        <TextBlock Text="▶ Animación" Style="{StaticResource TituloBarraStyle}"/>
                        <UniformGrid Columns="4">
                            <Button Content="▶" ToolTip="Reproducir" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="4,6" FontSize="11"/>
                            <Button Content="⏸" ToolTip="Pausar" Command="{Binding PauseCommand}" Style="{StaticResource BotonBarraStyle}"/>
                            <Button Content="⏭" ToolTip="Paso" Command="{Binding StepCommand}" Style="{StaticResource BotonBarraStyle}"/>
                            <Button Content="↺" ToolTip="Reiniciar" Command="{Binding ResetCommand}" Style="{StaticResource BotonBarraStyle}"/>
                        </UniformGrid>
                        <Grid Margin="1,6,1,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Velocidad" Style="{StaticResource SubtleTextStyle}" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="{Binding Velocidad, StringFormat={}{0:0.00}x}"
                                       FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <Slider Minimum="0.25" Maximum="4" Value="{Binding Velocidad}" TickFrequency="0.25" Margin="1,0" Height="20"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="170">
                    <StackPanel>
                        <TextBlock Text="📋 Estado" Style="{StaticResource TituloBarraStyle}"/>
                        <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="6,5">
                            <TextBlock Text="{Binding Log}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="9.5"
                                       Foreground="{StaticResource Accent2Brush}" MaxHeight="42"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TarjetaBarraStyle}" Width="210" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="🎨 Leyenda" Style="{StaticResource TituloBarraStyle}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource NodoSinVisitarBrush}" Stroke="#0B0D14" StrokeThickness="1" Margin="0,0,5,0"/>
                                <TextBlock Text="Sin visitar" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource NodoEnColaBrush}" Stroke="#0B0D14" StrokeThickness="1" Margin="0,0,5,0"/>
                                <TextBlock Text="En cola" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource NodoVisitandoBrush}" Stroke="#0B0D14" StrokeThickness="1" Margin="0,0,5,0"/>
                                <TextBlock Text="Revisando" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource NodoVisitadoBrush}" Stroke="#0B0D14" StrokeThickness="1" Margin="0,0,5,0"/>
                                <TextBlock Text="Terminado" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AristaExplorandoBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="Explorando" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AristaIncluidaBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="Incluida" Style="{StaticResource SubtleTextStyle}" FontSize="9.5"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>

        <!-- ===================== Contenido principal: lienzo + resultados ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- Lienzo del grafo -->
            <Grid Grid.Column="0" Margin="16">
                <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Canvas x:Name="LienzoGrafo" Background="{StaticResource CanvasDotGridBrush}" ClipToBounds="True"
                            MouseLeftButtonDown="LienzoGrafo_MouseLeftButtonDown">

                        <!-- Aristas: se dibujan primero para quedar debajo de los nodos -->
                        <ItemsControl ItemsSource="{Binding Aristas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="{Binding Estado, Converter={StaticResource EstadoAristaABrush}}"
                                              StrokeThickness="{Binding Estado, Converter={StaticResource EstadoAristaAGrosor}}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Polygon Points="{Binding PuntosFlecha}"
                                                 Fill="{Binding Estado, Converter={StaticResource EstadoAristaABrush}}"
                                                 Visibility="{Binding EsDirigida, Converter={StaticResource BoolAVisibilidad}}"/>
                                        <Border Canvas.Left="{Binding XEtiqueta}" Canvas.Top="{Binding YEtiqueta}"
                                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="7" Padding="6,1">
                                            <TextBlock Text="{Binding Peso}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Nodos -->
                        <ItemsControl ItemsSource="{Binding Nodos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="42" Height="42" Cursor="SizeAll"
                                          MouseLeftButtonDown="Nodo_MouseLeftButtonDown"
                                          MouseMove="Nodo_MouseMove"
                                          MouseLeftButtonUp="Nodo_MouseLeftButtonUp">
                                        <Ellipse Width="42" Height="42" Stroke="#0B0D14" StrokeThickness="1.6"
                                                 Fill="{Binding Estado, Converter={StaticResource EstadoNodoABrush}}"
                                                 Effect="{StaticResource NodeShadow}"/>
                                        <Ellipse Width="32" Height="15" Margin="5,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Etiqueta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" FontSize="13.5" Foreground="#14161F"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <!-- Insignia flotante: modo de edición actual -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                        Effect="{StaticResource CardShadow}" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Modo:" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ModoEdicion}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Panel lateral: Código en vivo / Resultado (en pestañas, cada una a todo el ancho) ===================== -->
            <Grid Grid.Column="1" Margin="0,16,16,16">
                <TabControl>

                    <!-- Pestaña: Código en vivo -->
                    <TabItem Header="💻 Código en vivo">
                        <Grid Margin="14,12,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding AlgoritmoSeleccionado.Nombre}" Style="{StaticResource SubtleTextStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6">
                                    <ItemsControl x:Name="ListaCodigo" ItemsSource="{Binding LineasCodigo}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="FilaCodigo" Padding="9,2" Margin="0,0,0,1"
                                                        BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" FontFamily="Consolas" FontSize="11.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextAlignment="Right" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="TxtCodigo" Text="{Binding Texto}" FontFamily="Consolas" FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EsComentario}" Value="True">
                                                        <Setter TargetName="TxtCodigo" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Setter TargetName="TxtCodigo" Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                        <Setter TargetName="FilaCodigo" Property="Background" Value="{StaticResource LineaCodigoActualBrush}"/>
                                                        <Setter TargetName="FilaCodigo" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="TxtCodigo" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Setter TargetName="TxtCodigo" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Pestaña: Resultado paso a paso -->
                    <TabItem Header="📊 Resultado">
                        <Grid Margin="14,12,14,14">
                            <Grid Visibility="{Binding TablaResultado, Converter={StaticResource NuloAVisibilidad}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding AlgoritmoSeleccionado.Nombre}" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,10"/>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <DataGrid x:Name="GridResultado" HorizontalAlignment="Left"/>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource Accent2Brush}" BorderThickness="1"
                                        CornerRadius="7" Padding="10,8" Margin="0,10,0,0"
                                        Visibility="{Binding TablaResultado.Resumen, Converter={StaticResource CadenaAVisibilidad}}">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TablaResultado.Resumen}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource Accent2Brush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Mensaje cuando todavía no hay ningún algoritmo ejecutado -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding TablaResultado, Converter={StaticResource EsNuloAVisibilidad}}">
                                <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="Acá vas a ver el resultado" HorizontalAlignment="Center" Margin="0,10,0,2"
                                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="paso a paso de cada algoritmo" HorizontalAlignment="Center"
                                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
