<Window x:Class="SimuladorGrafos.Views.VentanaPesoArista"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva arista" Height="240" Width="320"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="🔗 Nueva arista" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

        <TextBlock Text="Peso de la arista" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtPeso" Text="1" Margin="0,0,0,14"/>

        <CheckBox x:Name="ChkDirigida" Content="Es dirigida (con flecha)" IsChecked="True" Margin="0,0,0,22"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="86" Margin="0,0,8,0" Click="BtnCancelar_Click" IsCancel="True"/>
            <Button Content="Aceptar" Width="86" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnAceptar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
